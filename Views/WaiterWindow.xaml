<Window x:Class="KaraokeClub.Views.WaiterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:KaraokeClub.Converters"
        Title="PARK ZONE — Официант"
        Width="1280" Height="760"
        MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        WindowState="Maximized"
        Icon="/logo.png">

    <Window.Resources>
        <conv:ImagePathConverter       x:Key="ImgPath"/>
        <conv:EnumToBoolConverter      x:Key="EnumBool"/>
        <conv:EqToVisibilityConverter  x:Key="EqVis"/>
        <BooleanToVisibilityConverter  x:Key="BoolVis"/>

        <SolidColorBrush x:Key="BgPanel"   Color="#252525"/>
        <SolidColorBrush x:Key="BgCard"    Color="#2d2d2d"/>
        <SolidColorBrush x:Key="BgHover"   Color="#333333"/>
        <SolidColorBrush x:Key="Accent"    Color="#639922"/>
        <SolidColorBrush x:Key="AccentDim" Color="#3B6D11"/>
        <SolidColorBrush x:Key="AccentBg"  Color="#1d3008"/>
        <SolidColorBrush x:Key="TextMain"  Color="#e8e8e8"/>
        <SolidColorBrush x:Key="TextSub"   Color="#999999"/>
        <SolidColorBrush x:Key="Clr_Border" Color="#3a3a3a"/>

        <!-- ══ NavBtn base ══════════════════════════════════════ -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{StaticResource TextSub}"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="Padding"                    Value="12,10"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize"                   Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- активный раздел подсвечивается через DataTrigger прямо на кнопке -->
        </Style>

        <!-- ══ SubBtn ════════════════════════════════════════════ -->
        <Style x:Key="SubBtn" TargetType="Button" BasedOn="{StaticResource NavBtn}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding"  Value="10,7"/>
        </Style>

        <!-- ══ AddBtn (зелёная кнопка «+ В заказ») ═════════════ -->
        <Style x:Key="AddBtn" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Accent}"/>
            <Setter Property="Foreground"      Value="#EAF3DE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ MenuCard ══════════════════════════════════════════ -->
        <Style x:Key="MenuCard" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Clr_Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══ QtyBtn ════════════════════════════════════════════ -->
        <Style x:Key="QtyBtn" TargetType="Button">
            <Setter Property="Width"           Value="24"/>
            <Setter Property="Height"          Value="24"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Foreground"      Value="{StaticResource TextSub}"/>
            <Setter Property="Background"      Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Clr_Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ SearchBox ═════════════════════════════════════════ -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMain}"/>
            <Setter Property="CaretBrush"      Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Clr_Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,7"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ TableChip (RadioButton) ════════════════════════════ -->
        <Style x:Key="TableChip" TargetType="RadioButton">
            <Setter Property="Background"      Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextSub}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Clr_Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="20"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="{StaticResource Accent}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="#EAF3DE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Кнопка «Очистить» ════════════════════════════════ -->
        <Style x:Key="ClearBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TextSub}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Clr_Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════════
         ГЛАВНАЯ СЕТКА: Сайдбар | Центр | Корзина
    ══════════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ╔═══════════════════════════╗
             ║         САЙДБАР          ║
             ╚═══════════════════════════╝ -->
        <Border Grid.Column="0" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource Clr_Border}" BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Шапка -->
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,12">
                    <TextBlock Text="PARK ZONE" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSub}"/>
                    <TextBlock Text="Официант" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMain}" Margin="0,2,0,0"/>
                    <Border Height="1" Background="{StaticResource Clr_Border}" Margin="0,12,0,0"/>

                    <!-- Аватар + имя сотрудника -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Width="38" Height="38" CornerRadius="19" Background="#1D9E75">
                            <TextBlock Text="👤"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="18"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FullName}"
           FontSize="13" FontWeight="SemiBold"
           Foreground="{StaticResource TextMain}"/>
                            <TextBlock Text="{Binding RoleName}"
           FontSize="11" Foreground="{StaticResource TextSub}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Выход -->
                <Border DockPanel.Dock="Bottom" Margin="16,0,16,8">
                    <Button Content="🚪  Выйти"
                            Foreground="#e05252"
                            Background="Transparent"
                            BorderBrush="#3a3a3a"
                            BorderThickness="1"
                            Padding="12,8"
                            Cursor="Hand"
                            FontSize="13"
                            HorizontalContentAlignment="Left"
                            Click="Logout_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="8"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2a1010"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#e05252"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>

                <!-- Выбор стола — внизу -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
                    <Border Height="1" Background="{StaticResource Clr_Border}" Margin="0,0,0,10"/>
                    <TextBlock Text="СТОЛ" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSub}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Tables}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding}"
                                      GroupName="Tables"
                                        Style="{StaticResource TableChip}"
                                         Margin="0,0,4,4"
                                         Command="{Binding DataContext.SelectTableCommand,
                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding}">
                                    <RadioButton.IsChecked>
                                        <MultiBinding Converter="{StaticResource EnumBool}" Mode="OneWay">
                                            <Binding Path="DataContext.SelectedTable"
                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            <Binding/>
                                        </MultiBinding>
                                    </RadioButton.IsChecked>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Навигация -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,0">
                        <TextBlock Text="МЕНЮ" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSub}" Margin="6,4,0,8"/>

                        <!-- БАР -->
                        <Button Style="{StaticResource NavBtn}"
                                Command="{Binding NavBarCommand}">
                            <Button.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="Bar">
                                            <Setter Property="Background" Value="{StaticResource AccentBg}"/>
                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                            <Setter Property="FontWeight"  Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🍹" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="  Бар" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Подкатегории Бара -->
                        <ItemsControl ItemsSource="{Binding BarTypes}"
                                      Visibility="{Binding ActiveSection,
                                          Converter={StaticResource EqVis},
                                          ConverterParameter=Bar}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="16,0,0,0"
                                            Command="{Binding DataContext.ScrollToTypeCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SubBtn}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource EnumBool}">
                                                                <Binding Path="DataContext.ActiveSubType.Id"
                                                                         RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                <Binding Path="Id"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{StaticResource AccentBg}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                        <Setter Property="FontWeight"  Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="· " Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- КУХНЯ -->
                        <Button Style="{StaticResource NavBtn}"
                                Margin="0,2,0,0"
                                Command="{Binding NavKitchenCommand}">
                            <Button.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="Kitchen">
                                            <Setter Property="Background" Value="{StaticResource AccentBg}"/>
                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                            <Setter Property="FontWeight"  Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🍽️" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="  Кухня" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Подкатегории Кухни -->
                        <ItemsControl ItemsSource="{Binding KitchenTypes}"
                                      Visibility="{Binding ActiveSection,
                                          Converter={StaticResource EqVis},
                                          ConverterParameter=Kitchen}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="16,0,0,0"
                                            Command="{Binding DataContext.ScrollToTypeCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SubBtn}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource EnumBool}">
                                                                <Binding Path="DataContext.ActiveSubType.Id"
                                                                         RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                <Binding Path="Id"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background" Value="{StaticResource AccentBg}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                        <Setter Property="FontWeight"  Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="· " Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- КАРАОКЕ -->
                        <Button Style="{StaticResource NavBtn}"
                                Margin="0,2,0,0"
                                Command="{Binding NavKaraokeCommand}">
                            <Button.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="Karaoke">
                                            <Setter Property="Background" Value="{StaticResource AccentBg}"/>
                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                            <Setter Property="FontWeight"  Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎤" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="  Караоке" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{StaticResource Clr_Border}" Margin="6,10"/>
                        <TextBlock Text="ЗАКАЗЫ" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSub}" Margin="6,0,0,8"/>

                        <!-- МОИ ЗАКАЗЫ -->
                        <Button Style="{StaticResource NavBtn}"
                                Command="{Binding NavOrdersCommand}">
                            <Button.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="MyOrders">
                                            <Setter Property="Background" Value="{StaticResource AccentBg}"/>
                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                            <Setter Property="FontWeight"  Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="  Мои заказы" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ╔═══════════════════════════╗
             ║         ЦЕНТР            ║
             ╚═══════════════════════════╝ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Поиск -->
            <Border Grid.Row="0" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource Clr_Border}" BorderThickness="0,0,0,1"
                    Padding="14,10">
                <TextBox Style="{StaticResource SearchBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </Border>

            <!-- Welcome -->
            <Border Grid.Row="1"
                    Visibility="{Binding ShowWelcome, Converter={StaticResource BoolVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🎤" FontSize="64" HorizontalAlignment="Center"/>
                    <TextBlock Text="Добро пожаловать!" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMain}"
                               HorizontalAlignment="Center" Margin="0,12,0,6"/>
                    <TextBlock Text="Выберите раздел в меню слева" FontSize="14"
                               Foreground="{StaticResource TextSub}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Сетка товаров Бар (сгруппированная) -->
            <ScrollViewer x:Name="BarScrollViewer"
                          Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowGroupedBar, Converter={StaticResource BoolVis}}">
                <ItemsControl ItemsSource="{Binding GroupedBarItems}" Margin="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- Заголовок секции с якорем -->
                                <Border x:Name="GroupAnchor"
                                        Tag="{Binding Type}"
                                        Margin="6,16,6,8" Padding="0,0,0,10"
                                        BorderBrush="{StaticResource Clr_Border}"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="4" CornerRadius="2"
                                                Background="{StaticResource Accent}"
                                                Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Type.Name}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMain}"
                                                   VerticalAlignment="Center"/>
                                        <Border CornerRadius="10" Padding="8,2"
                                                Background="{StaticResource AccentBg}"
                                                Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Accent}">
                                                <Run Text="{Binding Items.Count, Mode=OneWay}"/>
                                                <Run Text=" поз."/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <!-- Карточки -->
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource MenuCard}"
                                                    Width="180" Margin="6"
                                                    Tag="{Binding}"
                                                    MouseLeftButtonUp="Card_Click">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="110"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" CornerRadius="10,10,0,0"
                                                            ClipToBounds="True" Background="#333333">
                                                        <Grid>
                                                            <Image Source="{Binding ImagePath, Converter={StaticResource ImgPath}}"
                                                                   Stretch="UniformToFill"/>
                                                            <TextBlock FontSize="36"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text"       Value="🍹"/>
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Row="1" Margin="10,8,10,10">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextMain}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding WeightVolume}"
                                                                   FontSize="11" Foreground="{StaticResource TextSub}"
                                                                   Margin="0,2,0,6"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       FontSize="15" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Accent}"
                                                                       VerticalAlignment="Center">
                                                                <Run Text="{Binding Price, StringFormat={}{0:F0}}"/>
                                                                <Run Text=" MDL"/>
                                                            </TextBlock>
                                                            <Button Grid.Column="1"
                                                                    Style="{StaticResource AddBtn}"
                                                                    Width="28" Height="28"
                                                                    Content="+" FontSize="16" Padding="0"
                                                                    Command="{Binding DataContext.AddMenuItemCommand,
                                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Сетка товаров Кухня (сгруппированная) -->
            <ScrollViewer x:Name="KitchenScrollViewer"
                          Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowGroupedKitchen, Converter={StaticResource BoolVis}}">
                <ItemsControl ItemsSource="{Binding GroupedKitchenItems}" Margin="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border x:Name="GroupAnchor"
                                        Tag="{Binding Type}"
                                        Margin="6,16,6,8" Padding="0,0,0,10"
                                        BorderBrush="{StaticResource Clr_Border}"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="4" CornerRadius="2"
                                                Background="{StaticResource Accent}"
                                                Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Type.Name}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMain}"
                                                   VerticalAlignment="Center"/>
                                        <Border CornerRadius="10" Padding="8,2"
                                                Background="{StaticResource AccentBg}"
                                                Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Accent}">
                                                <Run Text="{Binding Items.Count, Mode=OneWay}"/>
                                                <Run Text=" поз."/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource MenuCard}"
                                                    Width="180" Margin="6"
                                                    Tag="{Binding}"
                                                    MouseLeftButtonUp="Card_Click">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="110"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" CornerRadius="10,10,0,0"
                                                            ClipToBounds="True" Background="#333333">
                                                        <Grid>
                                                            <Image Source="{Binding ImagePath, Converter={StaticResource ImgPath}}"
                                                                   Stretch="UniformToFill"/>
                                                            <TextBlock FontSize="36"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text"       Value="🍽️"/>
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Row="1" Margin="10,8,10,10">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextMain}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding WeightVolume}"
                                                                   FontSize="11" Foreground="{StaticResource TextSub}"
                                                                   Margin="0,2,0,6"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       FontSize="15" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Accent}"
                                                                       VerticalAlignment="Center">
                                                                <Run Text="{Binding Price, StringFormat={}{0:F0}}"/>
                                                                <Run Text=" MDL"/>
                                                            </TextBlock>
                                                            <Button Grid.Column="1"
                                                                    Style="{StaticResource AddBtn}"
                                                                    Width="28" Height="28"
                                                                    Content="+" FontSize="16" Padding="0"
                                                                    Command="{Binding DataContext.AddMenuItemCommand,
                                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!-- Karaoke список -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowKaraokeGrid, Converter={StaticResource BoolVis}}">
                <ItemsControl ItemsSource="{Binding DisplayedKaraoke}" Margin="14">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MenuCard}"
                                    Margin="0,0,0,8" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🎤 " FontSize="15" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextMain}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12" Foreground="{StaticResource TextSub}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent}"
                                                   VerticalAlignment="Center">
                                            <Run Text="{Binding Price, StringFormat={}{0:F0}}"/>
                                            <Run Text=" MDL"/>
                                        </TextBlock>
                                        <Button Margin="10,0,0,0"
                                                Style="{StaticResource AddBtn}"
                                                Width="80" Padding="0,6"
                                                Content="+ В заказ" FontSize="12" FontWeight="SemiBold"
                                                Command="{Binding DataContext.AddKaraokeCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Мои заказы -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowOrdersPanel, Converter={StaticResource BoolVis}}">
                <ItemsControl ItemsSource="{Binding MyOrders}" Margin="14">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MenuCard}"
                                    Margin="0,0,0,8" Padding="14,12"
                                    Cursor="Hand"
                                    Tag="{Binding}"
                                    MouseLeftButtonUp="OrderCard_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMain}">
                                            <Run Text="Стол "/>
                                            <Run Text="{Binding TableNumber}"/>
                                            <Run Text="  ·  #"/>
                                            <Run Text="{Binding Id}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextSub}"
                                                   Margin="0,4,0,0">
                                            <Run Text="{Binding CreatedAt, StringFormat={}{0:HH:mm  dd.MM.yyyy}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="20" Padding="10,4"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource AccentBg}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="closed">
                                                        <Setter Property="Background" Value="#2d2d2d"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                                        <Setter Property="Background" Value="#3d1a1a"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="closed">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                                            <Setter Property="Foreground" Value="#e05252"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ╔═══════════════════════════╗
             ║         КОРЗИНА          ║
             ╚═══════════════════════════╝ -->
        <Border Grid.Column="2" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource Clr_Border}" BorderThickness="1,0,0,0">
            <DockPanel>

                <!-- Шапка корзины -->
                <Border DockPanel.Dock="Top" Padding="16,14"
                        BorderBrush="{StaticResource Clr_Border}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Текущий заказ"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMain}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1" CornerRadius="20" Padding="10,4"
                                Background="{StaticResource AccentBg}">
                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}">
                                <Run Text="Стол "/>
                                <Run Text="{Binding SelectedTable}"/>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>

                <!-- Футер: итого + кнопки -->
                <Border DockPanel.Dock="Bottom" Padding="14,12"
                        BorderBrush="{StaticResource Clr_Border}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Итого" FontSize="13"
                                       Foreground="{StaticResource TextSub}"
                                       VerticalAlignment="Center"/>
                            <TextBlock HorizontalAlignment="Right"
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMain}">
                                <Run Text="{Binding CartTotal, StringFormat={}{0:F2}, Mode=OneWay}"/>
                                <Run Text=" MDL"/>
                            </TextBlock>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Очистить"
                                    Style="{StaticResource ClearBtn}"
                                    Padding="0,9"
                                    Command="{Binding ClearCartCommand}"/>
                            <Button Grid.Column="2" Content="Отправить заказ"
                                    Style="{StaticResource AddBtn}"
                                    Padding="0,9" FontSize="13" FontWeight="SemiBold"
                                    Command="{Binding SubmitOrderCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Пустая корзина / список позиций -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- Пусто -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Margin="0,40,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cart.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="🛒" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="Корзина пуста" FontSize="13"
                                       Foreground="{StaticResource TextSub}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="Добавьте позиции из меню"
                                       FontSize="12" Foreground="{StaticResource TextSub}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Позиции -->
                        <ItemsControl ItemsSource="{Binding Cart}" Margin="12,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,8"
                                            BorderBrush="{StaticResource Clr_Border}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Иконка -->
                                            <Border Grid.Column="0" Width="34" Height="34"
                                                    CornerRadius="8" Background="{StaticResource BgCard}"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource ImgPath}}"
                                                           Stretch="UniformToFill"/>
                                                    <TextBlock Text="{Binding Icon}" FontSize="18"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>

                                            <!-- Название + qty -->
                                            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMain}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11"
                                                           Foreground="{StaticResource TextSub}"
                                                           Margin="0,2,0,0">
                                                    <Run Text="{Binding UnitPrice, StringFormat={}{0:F0}}"/>
                                                    <Run Text=" MDL"/>
                                                </TextBlock>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Button Style="{StaticResource QtyBtn}" Content="−"
                                                            Command="{Binding DataContext.DecreaseQtyCommand,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <TextBlock Text="{Binding Quantity}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextMain}"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0" MinWidth="16"
                                                               TextAlignment="Center"/>
                                                    <Button Style="{StaticResource QtyBtn}" Content="+"
                                                            Command="{Binding DataContext.IncreaseQtyCommand,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                                <!-- Заметка к позиции -->
                                                <Border Margin="0,5,0,0" CornerRadius="6"
                                                        Background="#1a1a1a"
                                                        BorderBrush="#333" BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock Text="✏  Заметка..." FontSize="11"
                                                                   Foreground="#555" Margin="8,5"
                                                                   VerticalAlignment="Top"
                                                                   IsHitTestVisible="False">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Notes}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Notes}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="Transparent"
                                                                 Foreground="#aaa"
                                                                 CaretBrush="#aaa"
                                                                 BorderThickness="0"
                                                                 Padding="8,5"
                                                                 FontSize="11"
                                                                 MaxLength="200"
                                                                 TextWrapping="Wrap"
                                                                 AcceptsReturn="False"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <!-- Цена + удалить -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMain}"
                                                           TextAlignment="Right">
                                                    <Run Text="{Binding Subtotal, Mode=OneWay, StringFormat={}{0:F0}}"/>
                                                    <Run Text=" MDL"/>
                                                </TextBlock>
                                                <Button Content="✕" FontSize="10"
                                                        Foreground="{StaticResource TextSub}"
                                                        Background="Transparent"
                                                        BorderThickness="0" Cursor="Hand"
                                                        HorizontalAlignment="Right" Margin="0,4,0,0"
                                                        Command="{Binding DataContext.RemoveCartItemCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>

            </DockPanel>
        </Border>
        <Grid x:Name="DetailOverlay"
              Grid.ColumnSpan="3"
              Visibility="Collapsed"
              Background="#BB000000"
              Panel.ZIndex="100"
              MouseDown="DetailOverlay_MouseDown">

            <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#252525" BorderBrush="#3a3a3a"
                    BorderThickness="1" CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="14,14,0,0" ClipToBounds="True" Background="#333">
                        <Grid>
                            <Image x:Name="DetailImage" Stretch="UniformToFill"/>
                            <TextBlock x:Name="DetailIcon" FontSize="72"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <Button Grid.Row="0" Content="✕" Width="34" Height="34"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,10,10,0" FontSize="14" FontWeight="Bold"
                            Foreground="#e8e8e8" Background="#66000000"
                            BorderThickness="0" Cursor="Hand" Panel.ZIndex="10"
                            Click="CloseDetail_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="17" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Grid.Row="1" Margin="22,16,22,22">
                        <TextBlock x:Name="DetailName" FontSize="20" FontWeight="SemiBold"
                                   Foreground="#e8e8e8" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="⚖  " FontSize="12" Foreground="#999"/>
                            <TextBlock x:Name="DetailWeight" FontSize="12" Foreground="#999"/>
                        </StackPanel>
                        <Border Margin="0,12,0,0" Background="#1e1e1e" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="СОСТАВ" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#639922" Margin="0,0,0,5"/>
                                <TextBlock x:Name="DetailIngredients" FontSize="12"
                                           Foreground="#cccccc" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="DetailCookingPanel" Orientation="Horizontal"
                                    Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="⏱  " FontSize="12" Foreground="#999"/>
                            <TextBlock x:Name="DetailCooking" FontSize="12" Foreground="#999"/>
                        </StackPanel>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="28" FontWeight="SemiBold"
                                       Foreground="#639922" VerticalAlignment="Center">
                                <Run x:Name="DetailPrice"/>
                                <Run Text=" MDL"/>
                            </TextBlock>
                            <Button Grid.Column="1" Content="+ В заказ"
                                    Style="{StaticResource AddBtn}"
                                    Padding="20,10" FontSize="14" FontWeight="SemiBold"
                                    Click="DetailAdd_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
