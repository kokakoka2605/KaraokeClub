<Window x:Class="KaraokeClub.Views.OrderDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали заказа"
        Width="520" SizeToContent="Height"
        MaxHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1e1e1e"
        Icon="/logo.png">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#639922"/>
            <Setter Property="Margin"       Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Шапка ── -->
        <Border Grid.Row="0" Background="#252525"
                BorderBrush="#3a3a3a" BorderThickness="0,0,0,1"
                Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="#e8e8e8">
                            <Run Text="Стол "/>
                            <Run x:Name="TxtTable" Foreground="#639922"/>
                            <Run Text="  ·  #"/>
                            <Run x:Name="TxtOrderId" Foreground="#e8e8e8"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock x:Name="TxtDate" FontSize="12" Foreground="#888"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Статус-бейдж -->
                <Border Grid.Column="1" x:Name="StatusBadge"
                        CornerRadius="20" Padding="14,6"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" FontSize="13" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- ── Тело: список позиций ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      MaxHeight="420">
            <StackPanel Margin="20,16">

                <!-- Заголовок таблицы -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ПОЗИЦИЯ"  Style="{StaticResource SectionLabel}"/>
                    <TextBlock Grid.Column="1" Text="КОЛ-ВО"   Style="{StaticResource SectionLabel}" TextAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="ЦЕНА"     Style="{StaticResource SectionLabel}" TextAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="СУММА"    Style="{StaticResource SectionLabel}" TextAlignment="Right"/>
                </Grid>

                <Border Height="1" Background="#2d2d2d" Margin="0,0,0,8"/>

                <!-- Строки позиций -->
                <ItemsControl x:Name="ItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,7,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка + название -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="6"
                                                Background="#2d2d2d" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Icon}" FontSize="14"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#e8e8e8"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="200"/>
                                            <TextBlock Text="{Binding Notes}"
                                                       FontSize="11" Foreground="#666"
                                                       Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasNotes}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Кол-во -->
                                    <Border Grid.Column="1" CornerRadius="12" Padding="8,3"
                                            Background="#2d2d2d" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Quantity}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#e8e8e8" TextAlignment="Center"/>
                                    </Border>

                                    <!-- Цена за ед. -->
                                    <TextBlock Grid.Column="2"
                                               FontSize="13" Foreground="#999"
                                               VerticalAlignment="Center" TextAlignment="Right">
                                        <Run Text="{Binding UnitPrice, Mode=OneWay, StringFormat={}{0:F0}}"/>
                                        <Run Text=" MDL"/>
                                    </TextBlock>

                                    <!-- Итого по позиции -->
                                    <TextBlock Grid.Column="3"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="#e8e8e8"
                                               VerticalAlignment="Center" TextAlignment="Right">
                                        <Run Text="{Binding Subtotal, Mode=OneWay, StringFormat={}{0:F0}}"/>
                                        <Run Text=" MDL"/>
                                    </TextBlock>
                                </Grid>

                                <!-- Разделитель между позициями -->
                                <Border Grid.Row="1" Height="1" Background="#252525"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Пусто -->
                <StackPanel x:Name="EmptyPanel" Visibility="Collapsed"
                            HorizontalAlignment="Center" Margin="0,30">
                    <TextBlock Text="📋" FontSize="36" HorizontalAlignment="Center"/>
                    <TextBlock Text="Нет позиций в заказе" FontSize="13"
                               Foreground="#666" HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Футер: итого + кнопка ── -->
        <Border Grid.Row="2" Background="#252525"
                BorderBrush="#3a3a3a" BorderThickness="0,1,0,0"
                Padding="20,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Статистика -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="ПОЗИЦИЙ" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#639922" TextAlignment="Center"/>
                        <TextBlock x:Name="TxtItemCount" FontSize="20" FontWeight="Bold"
                                   Foreground="#e8e8e8" TextAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="0" Width="1" Background="#3a3a3a"
                            HorizontalAlignment="Right" Margin="0,4"/>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="ЕДИНИЦ" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#639922" TextAlignment="Center"/>
                        <TextBlock x:Name="TxtUnitCount" FontSize="20" FontWeight="Bold"
                                   Foreground="#e8e8e8" TextAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Background="#3a3a3a"
                            HorizontalAlignment="Right" Margin="0,4"/>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="ИТОГО" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#639922" TextAlignment="Center"/>
                        <TextBlock x:Name="TxtTotal" FontSize="20" FontWeight="Bold"
                                   Foreground="#e8e8e8" TextAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Кнопки оплаты (только для открытых заказов) -->
                <Grid Grid.Row="1" x:Name="PaymentPanel" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Наличные -->
                    <Button Grid.Column="0" x:Name="BtnCash"
                            Height="46" FontSize="14" FontWeight="SemiBold"
                            Cursor="Hand" Click="PayCash_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="10"
                                        Background="#1d3008" BorderBrush="#639922" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Иконка банкноты (Path) — зелёный цвет -->
                                        <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                            <Canvas Width="24" Height="24">
                                                <!-- Прямоугольник банкноты -->
                                                <Rectangle Canvas.Left="1" Canvas.Top="5"
                                                           Width="22" Height="14" RadiusX="2" RadiusY="2"
                                                           Stroke="#639922" StrokeThickness="1.5"
                                                           Fill="Transparent"/>
                                                <!-- Кружок по центру (монета/номинал) -->
                                                <Ellipse Canvas.Left="9" Canvas.Top="9"
                                                         Width="6" Height="6"
                                                         Stroke="#639922" StrokeThickness="1.5"
                                                         Fill="Transparent"/>
                                                <!-- Левая полоска -->
                                                <Line X1="4" Y1="8" X2="4" Y2="16"
                                                      Stroke="#639922" StrokeThickness="1.5"/>
                                                <!-- Правая полоска -->
                                                <Line X1="20" Y1="8" X2="20" Y2="16"
                                                      Stroke="#639922" StrokeThickness="1.5"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Наличные" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#639922" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2a4810"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Карта -->
                    <Button Grid.Column="2" x:Name="BtnCard"
                            Height="46" FontSize="14" FontWeight="SemiBold"
                            Cursor="Hand" Click="PayCard_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="10"
                                        Background="#0d1f3a" BorderBrush="#3a7bd5" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Иконка карты (Path) — синий цвет -->
                                        <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                            <Canvas Width="24" Height="24">
                                                <!-- Корпус карты -->
                                                <Rectangle Canvas.Left="1" Canvas.Top="5"
                                                           Width="22" Height="14" RadiusX="2" RadiusY="2"
                                                           Stroke="#3a7bd5" StrokeThickness="1.5"
                                                           Fill="Transparent"/>
                                                <!-- Полоса магнитная (верх) -->
                                                <Rectangle Canvas.Left="1" Canvas.Top="9"
                                                           Width="22" Height="3"
                                                           Fill="#3a7bd5"/>
                                                <!-- Чип -->
                                                <Rectangle Canvas.Left="4" Canvas.Top="14"
                                                           Width="5" Height="3" RadiusX="1" RadiusY="1"
                                                           Stroke="#3a7bd5" StrokeThickness="1"
                                                           Fill="Transparent"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="Карта" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#3a7bd5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#142d55"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Кнопка закрыть -->
                <Button Grid.Row="2" Content="Закрыть" Click="Close_Click"
                        Height="38" FontSize="13" FontWeight="SemiBold"
                        Foreground="#e8e8e8" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="10"
                                    Background="#2d2d2d" BorderBrush="#3a3a3a" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#383838"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
