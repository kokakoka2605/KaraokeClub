<Window x:Class="KaraokeClub.Views.EditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:KaraokeClub.Models"
        xmlns:vm="clr-namespace:KaraokeClub.ViewModels"
        xmlns:converters="clr-namespace:KaraokeClub.Converters"
        Title="Редактирование" Width="520" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#2d2d2d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:ImagePathConverter x:Key="ImagePathConv"/>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullToVisConv"/>

        <DataTemplate DataType="{x:Type models:Role}">
            <StackPanel Width="440">
                <Label Content="Название роли *"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="OnlyLetters_PreviewTextInput"/>
                <Label Content="Зарплата *" Margin="0,12,0,0"/>
                <TextBox Text="{Binding Salary, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="OnlyDecimal_PreviewTextInput"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:KaraokeOption}">
            <StackPanel Width="440">
                <Label Content="Название *"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Цена *" Margin="0,12,0,0"/>
                <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="OnlyDecimal_PreviewTextInput"/>
                <Label Content="Описание" Margin="0,12,0,0"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AppUserEditorViewModel}">
            <StackPanel Width="440">
                <Label Content="Логин *"/>
                <TextBox Text="{Binding Entity.Username, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="NoSpaces_PreviewTextInput"/>
                <Label Content="Пароль *" Margin="0,12,0,0"/>
                <TextBox Text="{Binding Entity.Password, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="NoSpaces_PreviewTextInput"/>

                <Label Content="Сотрудник (официант)" Margin="0,12,0,0"/>
                <ComboBox ItemsSource="{Binding Workers}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding Entity.WorkerId, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="В списке только официанты без аккаунта"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:OrderEditorViewModel}">
            <StackPanel Width="440">
                <Label Content="Номер стола *"/>
                <TextBox Text="{Binding Entity.TableNumber, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Сотрудник *" Margin="0,12,0,0"/>
                <ComboBox ItemsSource="{Binding Workers}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding Entity.WorkerId, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Кол-во гостей" Margin="0,12,0,0"/>
                <TextBox Text="{Binding Entity.GuestCount, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Статус только информационно, не редактируется (управляется через оплату счёта) -->
                <Label Content="Статус (только просмотр)" Margin="0,12,0,0"
                       Visibility="{Binding IsEditOrder, Converter={StaticResource BoolToVis}}"/>
                <TextBox Text="{Binding Entity.Status}" IsReadOnly="True" Foreground="#c8e000"
                         Visibility="{Binding IsEditOrder, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>

        <Style TargetType="Button">
            <Setter Property="Background"      Value="#4a7c1f"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="20 8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5a9625"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CancelBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#555a44"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6a7055"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#aaa"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Padding"    Value="0 0 0 2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="#383838"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#4a7c1f"/>
            <Setter Property="BorderThickness" Value="0 0 0 1"/>
            <Setter Property="Padding"         Value="6 4"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="CaretBrush"      Value="#c8e000"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background"         Value="#383838"/>
            <Setter Property="Foreground"         Value="White"/>
            <Setter Property="BorderBrush"        Value="#4a7c1f"/>
            <Setter Property="BorderThickness"    Value="0 0 0 1"/>
            <Setter Property="Padding"            Value="6 4"/>
            <Setter Property="FontSize"           Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"/>
                            <ToggleButton Background="Transparent" BorderThickness="0"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  Focusable="False" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                              Data="M 0 0 L 6 6 L 12 0"
                                              Stroke="#4a7c1f" StrokeThickness="2"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      Margin="8 5 30 5"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False"
                                      TextBlock.Foreground="White"/>
                            <Popup x:Name="PART_Popup"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                                <Border Background="#383838"
                                BorderBrush="#4a7c1f"
                                BorderThickness="1"
                                MinWidth="{TemplateBinding ActualWidth}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding"    Value="8 7"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bg"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#4a7c1f"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3a6215"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background"      Value="#383838"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#4a7c1f"/>
            <Setter Property="BorderThickness" Value="0 0 0 1"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="6 4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox"
                                           Grid.Column="0"
                                           Background="Transparent"
                                           Foreground="White"
                                           BorderThickness="0"
                                           Padding="8 5"
                                           FontSize="13"
                                           CaretBrush="White"
                                           SelectionBrush="#4a7c1f"
                                           VerticalContentAlignment="Center"/>
                                <Button x:Name="PART_Button"
                                Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Focusable="False"
                                Width="30">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <Path Data="M3,2 L3,0 M7,2 L7,0 M0,3 L10,3 M0,1 Q0,0 1,0 L9,0 Q10,0 10,1 L10,9 Q10,10 9,10 L1,10 Q0,10 0,9 Z M2,5 L4,5 L4,7 L2,7 Z M5,5 L7,5 L7,7 L5,7 Z M8,5 L10,5 L10,7 L8,7 Z M2,8 L4,8 L4,10 L2,10 Z M5,8 L7,8 L7,10 L5,10 Z"
                                              Stroke="#4a7c1f"
                                              StrokeThickness="0.9"
                                              Fill="Transparent"
                                              Width="14" Height="14"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=PART_TextBox}"
                               StaysOpen="False">
                                    <Border Background="#2d2d2d"
                                    BorderBrush="#4a7c1f"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                        <Calendar x:Name="PART_Calendar"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="White"
                                          FontSize="12"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CalendarButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarButton">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                        CornerRadius="4" Padding="4 3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#4a7c1f"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CalendarDayButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Width"      Value="30"/>
            <Setter Property="Height"     Value="28"/>
            <Setter Property="Margin"     Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                        CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                      TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#4a7c1f"/>
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1e3a0a"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#4a7c1f"/>
                                <Setter TargetName="bg" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Foreground" Value="#555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Calendar">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Calendar">
                        <CalendarItem x:Name="PART_CalendarItem"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              BorderThickness="0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CalendarItem">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarItem">
                        <ControlTemplate.Resources>
                            <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                                <TextBlock Text="{Binding}" Foreground="#4a7c1f"
                                   FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0 4 0 2"/>
                            </DataTemplate>
                        </ControlTemplate.Resources>
                        <Border Background="#2d2d2d" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <Grid Margin="0 0 0 6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PART_PreviousButton" Grid.Column="0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#4a7c1f" FontSize="14" FontWeight="Bold"
                                    Content="‹" Cursor="Hand" Focusable="False"/>
                                    <Button x:Name="PART_HeaderButton" Grid.Column="1"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="White" FontSize="13" FontWeight="Bold"
                                    Cursor="Hand" Focusable="False"/>
                                    <Button x:Name="PART_NextButton" Grid.Column="2"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#4a7c1f" FontSize="14" FontWeight="Bold"
                                    Content="›" Cursor="Hand" Focusable="False"/>
                                </Grid>
                                <Grid x:Name="PART_MonthView" Visibility="Visible"/>
                                <Grid x:Name="PART_YearView"  Visibility="Hidden"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize"   Value="13"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!--  DataTemplate для редактирования блюда меню                  -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <DataTemplate DataType="{x:Type vm:MenuItemEditorViewModel}">
            <StackPanel Width="440">

                <!-- Название -->
                <Label Content="Название *"/>
                <TextBox Text="{Binding Entity.Name, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Цена -->
                <Label Content="Цена (MDL) *" Margin="0,12,0,0"/>
                <TextBox Text="{Binding Entity.Price, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="OnlyDecimal_PreviewTextInput"/>

                <!-- Тип меню -->
                <Label Content="Тип меню *" Margin="0,12,0,0"/>
                <ComboBox ItemsSource="{Binding MenuTypes}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedTypeId, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Секция (автовыбирается, но можно поменять) -->
                <Label Content="Секция *" Margin="0,12,0,0"/>
                <ComboBox ItemsSource="{Binding Sections}"
                          SelectedItem="{Binding Entity.Section, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Вес / объём -->
                <Label Content="Вес / объём *" Margin="0,12,0,0"/>
                <TextBox Text="{Binding Entity.WeightVolume, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Например: 250 г  /  300 мл"/>

                <!-- Состав -->
                <Label Content="Состав *" Margin="0,12,0,0"/>
                <TextBox Text="{Binding Entity.Ingredients, UpdateSourceTrigger=PropertyChanged}"
                         Height="55" AcceptsReturn="True" TextWrapping="Wrap"/>

                <!-- Время приготовления -->
                <Label Content="Время приготовления (мин)" Margin="0,12,0,0"/>
                <TextBox Text="{Binding Entity.CookingTime, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Оставьте пустым если не актуально"/>

                <!-- ─── Картинка ─────────────────────────────────── -->
                <Label Content="Картинка" Margin="0,16,0,0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Путь (только для чтения, заполняется кнопкой) -->
                    <TextBox Grid.Column="0"
                             x:Name="TbImagePath"
                             Text="{Binding Entity.ImagePath, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True"
                             Foreground="#c8e000"
                             ToolTip="Относительный путь к файлу изображения"/>

                    <!-- Выбрать файл -->
                    <Button Grid.Column="1"
                            Content="📂"
                            Width="36" Margin="6,0,0,0"
                            ToolTip="Выбрать изображение"
                            Click="PickImage_Click"/>

                    <!-- Очистить -->
                    <Button Grid.Column="2"
                            Content="✕"
                            Width="36" Margin="4,0,0,0"
                            ToolTip="Удалить картинку"
                            Click="ClearImage_Click"/>
                </Grid>

                <!-- Превью -->
                <Border Margin="0,10,0,0" Width="160" Height="120"
                        HorizontalAlignment="Left"
                        Background="#1e1e1e" BorderBrush="#555" BorderThickness="1"
                        CornerRadius="4">
                    <Image x:Name="ImgPreview"
                           Stretch="Uniform" Margin="4"
                           Source="{Binding Entity.ImagePath,
                               Converter={StaticResource ImagePathConv}}"/>
                </Border>
                <TextBlock Text="Картинка не выбрана" Foreground="#888" FontSize="11"
                           Margin="0,4,0,0"
                           Visibility="{Binding Entity.ImagePath,
                               Converter={StaticResource NullToVisConv}}"/>

            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <DockPanel>
        <!-- Заголовок -->
        <Border DockPanel.Dock="Top" Background="#4a7c1f" Padding="16 12">
            <TextBlock x:Name="HeaderText" Text="✎  Редактирование записи" Foreground="White" FontSize="15" FontWeight="Bold"/>
        </Border>

        <!-- Кнопки снизу -->
        <Border DockPanel.Dock="Bottom" Background="#242424" Padding="16 10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"    Style="{StaticResource CancelBtn}" Click="Cancel_Click" Width="100"/>
                <Button Content="Сохранить" Click="Save_Click" Width="120" Margin="10 0 0 0"/>
            </StackPanel>
        </Border>

        <!-- Контент — DataTemplate подбирается автоматически по типу DataContext -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#2d2d2d">
            <ContentControl Content="{Binding}" Margin="20"/>
        </ScrollViewer>
    </DockPanel>
</Window>