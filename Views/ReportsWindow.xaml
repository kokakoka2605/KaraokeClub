<Window x:Class="KaraokeClub.Views.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KaraokeClub — Отчёты"
        Width="1280" Height="860"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7F2">

    <Window.Resources>
        <!-- ── Кнопка-вкладка отчёта ──────────────────────────────────────────── -->
        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18 10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#4a7c1f" BorderThickness="0 0 0 3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F5D8"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0 0 0 3"/>
                                <Setter Property="Foreground" Value="#3d6618"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D8EEC0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Кнопка действия (зелёная) ─────────────────────────────────── -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#4a7c1f"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16 8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5a9625"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BBBBBB"/>
                                <Setter Property="Foreground" Value="#777777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Синяя кнопка (печать) ─────────────────────────────── -->
        <Style x:Key="BlueBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#4a6fa5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5a82bc"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Label фильтра ─────────────────────────────────────────────────── -->
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4a7c1f"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0 0 0 4"/>
        </Style>

        <!-- ── ComboBox фильтра ──────────────────────────────────────────────── -->
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="BorderBrush" Value="#4a7c1f"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8 6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        ClickMode="Press">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                        <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                              Margin="0,0,8,0" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#4a7c1f"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            Margin="8,2,28,2"
                                            VerticalAlignment="Center"
                                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="White"
                                        BorderBrush="#4a7c1f"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <ScrollViewer MaxHeight="200">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DatePicker фильтра ────────────────────────────────────────────── -->
        <Style x:Key="FilterDate" TargetType="DatePicker">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="BorderBrush" Value="#4a7c1f"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <!-- ── TextBox фильтра ───────────────────────────────────────────────── -->
        <Style x:Key="FilterBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="BorderBrush" Value="#4a7c1f"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8 6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="CaretBrush" Value="#4a7c1f"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ══ ШАПКА ══════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Background="#4a7c1f" BorderThickness="0" Padding="22 14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/logo.png" Width="70" Height="45" RenderTransformOrigin="0.685,0.5" Margin="0 0 14 0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PARK ZONE" FontSize="20" FontWeight="Bold" Foreground="#c8e000"/>
                        <TextBlock Text="Модуль отчётов" FontSize="11" Foreground="#D2E8B0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Кнопки экспорта -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPrint" Content="🖨 Печать" Style="{StaticResource BlueBtn}" Margin="0 0 8 0" Click="BtnPrint_Click"/>
                    <Button x:Name="BtnSaveXps" Content="💾 Сохранить XPS" Style="{StaticResource ActionBtn}"
                            Background="#3d6618" Click="BtnSaveXps_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ ВКЛАДКИ ВЫБОРА ОТЧЁТА ══════════════════════════════ -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#BED8A0" BorderThickness="0 0 0 1">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="RbRevenue" Content="💰 Выручка за период"      Style="{StaticResource TabBtn}" IsChecked="True" Checked="ReportType_Changed"/>
                <RadioButton x:Name="RbMenu"    Content="🍽 Анализ меню и опций"   Style="{StaticResource TabBtn}"               Checked="ReportType_Changed"/>
                <RadioButton x:Name="RbStaff"   Content="👥 Нагрузка на персонал"  Style="{StaticResource TabBtn}"               Checked="ReportType_Changed"/>
            </StackPanel>
        </Border>

        <!-- ══ ПАНЕЛЬ ФИЛЬТРОВ ═════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Background="#FAFFF5" BorderBrush="#BED8A0" BorderThickness="0 0 0 1" Padding="16 12">
            <StackPanel>

                <!-- ── Фильтры: Выручка ──────────────────────────── -->
                <StackPanel x:Name="PanelRevenueFilters" Orientation="Horizontal">
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Text="С даты" Style="{StaticResource FilterLabel}"/>
                        <DatePicker x:Name="DpRevFrom" Style="{StaticResource FilterDate}"/>
                    </StackPanel>
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Text="По дату" Style="{StaticResource FilterLabel}"/>
                        <DatePicker x:Name="DpRevTo" Style="{StaticResource FilterDate}"/>
                    </StackPanel>
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Text="Сотрудник" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="CbRevWorker" Style="{StaticResource FilterCombo}"/>
                    </StackPanel>
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Text="Статус оплаты" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="CbRevStatus" Style="{StaticResource FilterCombo}" MinWidth="140"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom">
                        <Button Content="▶ Сформировать" Style="{StaticResource ActionBtn}" Click="BtnGenerate_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- ── Фильтры: Меню ──────────────────────────────── -->
                <StackPanel x:Name="PanelMenuFilters" Orientation="Horizontal" Visibility="Collapsed">
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Text="С даты" Style="{StaticResource FilterLabel}"/>
                        <DatePicker x:Name="DpMenuFrom" Style="{StaticResource FilterDate}"/>
                    </StackPanel>
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Text="По дату" Style="{StaticResource FilterLabel}"/>
                        <DatePicker x:Name="DpMenuTo" Style="{StaticResource FilterDate}"/>
                    </StackPanel>
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Text="Тип позиции" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="CbMenuItemType" Style="{StaticResource FilterCombo}" MinWidth="160"/>
                    </StackPanel>
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Text="Топ N позиций" Style="{StaticResource FilterLabel}"/>
                        <TextBox x:Name="TbTopN" Text="10" Style="{StaticResource FilterBox}" MinWidth="70" PreviewTextInput="OnlyDigits_PreviewTextInput"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom">
                        <Button Content="▶ Сформировать" Style="{StaticResource ActionBtn}" Click="BtnGenerate_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- ── Фильтры: Персонал ──────────────────────────── -->
                <StackPanel x:Name="PanelStaffFilters" Orientation="Horizontal" Visibility="Collapsed">
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Text="С даты" Style="{StaticResource FilterLabel}"/>
                        <DatePicker x:Name="DpStaffFrom" Style="{StaticResource FilterDate}"/>
                    </StackPanel>
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Text="По дату" Style="{StaticResource FilterLabel}"/>
                        <DatePicker x:Name="DpStaffTo" Style="{StaticResource FilterDate}"/>
                    </StackPanel>
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Text="Должность" Style="{StaticResource FilterLabel}"/>
                        <ComboBox x:Name="CbStaffRole" Style="{StaticResource FilterCombo}"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom">
                        <Button Content="▶ Сформировать" Style="{StaticResource ActionBtn}" Click="BtnGenerate_Click"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ══ ОБЛАСТЬ ПРОСМОТРА ОТЧЁТА ═══════════════════════════ -->
        <Border Background="White" Padding="0" BorderBrush="#E0E0E0" BorderThickness="0 1 0 0">
            <Grid>
                <!-- Placeholder пока отчёт не сформирован -->
                <StackPanel x:Name="PlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎤" FontSize="64" HorizontalAlignment="Center" Foreground="#C8E000"/>
                    <TextBlock Text="Выберите параметры и нажмите «Сформировать»"
                               Foreground="#888888" FontSize="16"
                               HorizontalAlignment="Center" Margin="0 12 0 0"/>
                </StackPanel>

                <!-- FlowDocumentReader -->
                <FlowDocumentReader x:Name="DocReader"
                                    Visibility="Collapsed"
                                    Background="White"
                                    ViewingMode="Scroll"
                                    Foreground="#212121"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>
