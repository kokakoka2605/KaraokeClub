<Window x:Class="KaraokeClub.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KaraokeClub.Controls"
        Title="Karaoke Club — Аналитика"
        Width="1380" Height="900"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F2F6EE"
        Icon="/logo.png">

    <Window.Resources>

        <!-- ── Цвета ──────────────────────────────────────────── -->
        <SolidColorBrush x:Key="BgPage"       Color="#F2F6EE"/>
        <SolidColorBrush x:Key="BgCard"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgHeader"     Color="#2f4b16"/>
        <SolidColorBrush x:Key="BgFilterBar"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#4a7c1f"/>
        <SolidColorBrush x:Key="AccentLight"  Color="#6aaa2f"/>
        <SolidColorBrush x:Key="TextDark"     Color="#1a2e0a"/>
        <SolidColorBrush x:Key="TextMid"      Color="#3d5a1d"/>
        <SolidColorBrush x:Key="TextLight"    Color="#7aaa40"/>
        <SolidColorBrush x:Key="BorderLight"  Color="#c8deb0"/>

        <!-- ── Тени ───────────────────────────────────────────── -->
        <DropShadowEffect x:Key="CardShadow"
                          Color="#000000" Opacity="0.07"
                          BlurRadius="16" ShadowDepth="2" Direction="270"/>
        <DropShadowEffect x:Key="KpiShadow"
                          Color="#4a7c1f" Opacity="0.12"
                          BlurRadius="20" ShadowDepth="0"/>

        <!-- ── Стиль карточки ────────────────────────────────── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"   Value="{StaticResource BgCard}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect"       Value="{StaticResource CardShadow}"/>
            <Setter Property="Padding"      Value="18"/>
            <Setter Property="Margin"       Value="6"/>
        </Style>

        <!-- ── Заголовок секции ──────────────────────────────── -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Margin"     Value="0 0 0 12"/>
        </Style>

        <!-- ── Кнопка применить ─────────────────────────────── -->
        <Style x:Key="BtnApply" TargetType="Button">
            <Setter Property="Background"      Value="#4a7c1f"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16 8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2f4b16"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Кнопка сброс ─────────────────────────────────── -->
        <Style x:Key="BtnReset" TargetType="Button" BasedOn="{StaticResource BtnApply}">
            <Setter Property="Background" Value="#78909C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#546E7A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Кнопка экспорт ───────────────────────────────── -->
        <Style x:Key="BtnExport" TargetType="Button" BasedOn="{StaticResource BtnApply}">
            <Setter Property="Background" Value="#6aaa2f"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4a7c1f"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── ComboBox фильтров ─────────────────────────────── -->
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Background"      Value="#F4F8EF"/>
            <Setter Property="BorderBrush"     Value="#c8deb0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8 6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="MinWidth"        Value="130"/>
            <Setter Property="Foreground" Value="#1a2e0a"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#1a2e0a"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#E8F5D8"/>
                    <Setter Property="Foreground" Value="#2f4b16"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── DatePicker фильтров ───────────────────────────── -->
        <Style x:Key="FilterDate" TargetType="DatePicker">
            <Setter Property="Background" Value="#F4F8EF"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="MinWidth"   Value="115"/>
        </Style>

        <!-- ── DataGrid ──────────────────────────────────────── -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"               Value="White"/>
            <Setter Property="RowBackground"            Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F4F8EF"/>
            <Setter Property="Foreground"               Value="#1a2e0a"/>
            <Setter Property="BorderBrush"              Value="#c8deb0"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#dff0cc"/>
            <Setter Property="SelectionMode"            Value="Single"/>
            <Setter Property="SelectionUnit"            Value="FullRow"/>
            <Setter Property="AutoGenerateColumns"      Value="False"/>
            <Setter Property="CanUserAddRows"           Value="False"/>
            <Setter Property="CanUserDeleteRows"        Value="False"/>
            <Setter Property="IsReadOnly"               Value="True"/>
            <Setter Property="HeadersVisibility"        Value="Column"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#4a7c1f"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="10 7"/>
            <Setter Property="BorderBrush"     Value="#3d6618"/>
            <Setter Property="BorderThickness" Value="0 0 1 0"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#c8deb0"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#e4f0d4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding"         Value="8 4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#2f4b16"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <DockPanel>

        <!-- ══ ШАПКА ════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BgHeader}"
                Padding="24 14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Лого + заголовок -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#4a7c1f" CornerRadius="8"
                            Padding="10 6" Margin="0 0 14 0">
                        <Image Source="/logo.png" Width="73" Height="51" RenderTransformOrigin="0.685,0.5" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                                   FontSize="20" FontWeight="Bold" Foreground="White" Text="PARK ZONE"/>
                        <TextBlock Text="Панель аналитики"
                                   FontSize="11" Foreground="#a8d080"/>
                    </StackPanel>
                </StackPanel>

                <!-- Статус -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12" Foreground="#a8d080"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding LastUpdated}"
                               FontSize="10" Foreground="#7aaa40"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Экспорт -->
                <Button Grid.Column="2" Content="⬇  Экспорт CSV"
                        Style="{StaticResource BtnExport}"
                        Command="{Binding ExportCommand}"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══ ПАНЕЛЬ ФИЛЬТРОВ ══════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BgFilterBar}"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0 0 0 1"
                Padding="18 10">
            <WrapPanel VerticalAlignment="Center">

                <!-- Иконка -->
                <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center"
                           Margin="0 0 10 0"/>

                <!-- Период -->
                <TextBlock Text="Период:" FontSize="11" Foreground="{StaticResource TextMid}"
                           VerticalAlignment="Center" Margin="0 0 6 0"/>
                <DatePicker SelectedDate="{Binding DateFrom}"
                            Style="{StaticResource FilterDate}"/>
                <TextBlock Text="—" VerticalAlignment="Center"
                           Margin="6 0" Foreground="{StaticResource TextLight}"/>
                <DatePicker SelectedDate="{Binding DateTo}"
                            Style="{StaticResource FilterDate}"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                           Margin="12 0"/>

                <!-- Статус -->
                <TextBlock Text="Статус:" FontSize="11" Foreground="{StaticResource TextMid}"
                           VerticalAlignment="Center" Margin="0 0 6 0"/>
                <ComboBox ItemsSource="{Binding StatusList}"
                          SelectedItem="{Binding SelectedStatus}"
                          Style="{StaticResource FilterCombo}" MinWidth="110"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                           Margin="12 0"/>

                <!-- Сотрудник -->
                <TextBlock Text="Сотрудник:" FontSize="11" Foreground="{StaticResource TextMid}"
                           VerticalAlignment="Center" Margin="0 0 6 0"/>
                <ComboBox ItemsSource="{Binding WorkerList}"
                          SelectedItem="{Binding SelectedWorker}"
                          Style="{StaticResource FilterCombo}" MinWidth="140"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                           Margin="12 0"/>

                <!-- Сумма -->
                <TextBlock Text="Сумма от:" FontSize="11" Foreground="{StaticResource TextMid}"
                           VerticalAlignment="Center" Margin="0 0 6 0"/>
                <TextBox Width="80" Padding="6 5" FontSize="12"
                         BorderBrush="#c8deb0" BorderThickness="1"
                         Text="{Binding MinAmount, UpdateSourceTrigger=LostFocus}"/>
                <TextBlock Text="до:" FontSize="11" Foreground="{StaticResource TextMid}"
                           VerticalAlignment="Center" Margin="8 0 6 0"/>
                <TextBox Width="80" Padding="6 5" FontSize="12"
                         BorderBrush="#c8deb0" BorderThickness="1"
                         Text="{Binding MaxAmount, UpdateSourceTrigger=LostFocus}"/>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                           Margin="12 0"/>

                <!-- Кнопки -->
                <Button Content="✔  Применить"
                        Style="{StaticResource BtnApply}"
                        Command="{Binding ApplyFiltersCommand}"
                        Margin="0 0 8 0"/>
                <Button Content="↺  Сброс"
                        Style="{StaticResource BtnReset}"
                        Command="{Binding ResetFiltersCommand}"/>
            </WrapPanel>
        </Border>

        <!-- ══ ОСНОВНОЙ КОНТЕНТ ══════════════════════════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{StaticResource BgPage}">
            <StackPanel Margin="12 10 12 20">

                <!-- ── KPI CARDS ─────────────────────────────── -->
                <ItemsControl ItemsSource="{Binding KpiCards}" Margin="0 0 0 4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="5"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="6 4" CornerRadius="12"
                                    Background="White"
                                    Effect="{StaticResource KpiShadow}"
                                    Padding="14 12"
                                    BorderThickness="0 3 0 0"
                                    BorderBrush="{Binding Color}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
                                        <TextBlock Text="{Binding Icon}" FontSize="18"
                                                   Margin="0 0 8 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="10" Foreground="#5a8030"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" MaxWidth="90"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Value}"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="#1a2e0a"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SubValue}"
                                               FontSize="10" Foreground="#6aaa2f"
                                               Margin="0 2 0 0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ── СТРОКА 1: Линейный + Пирог ───────────── -->
                <Grid Margin="0 4 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Линейный: выручка по дням -->
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                        Margin="0 0 0 8">
                                <Border Background="#E8F5D8" CornerRadius="6"
                                        Padding="6 3" Margin="0 0 10 0">
                                    <TextBlock Text="📈" FontSize="14"/>
                                </Border>
                                <TextBlock Text="Выручка по дням"
                                           Style="{StaticResource SectionTitle}"
                                           Margin="0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <local:LineChart Items="{Binding RevenueByDay}" Height="210"/>
                        </DockPanel>
                    </Border>

                    <!-- Круговой: по статусам -->
                    <Border Style="{StaticResource Card}" Grid.Column="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                        Margin="0 0 0 8">
                                <Border Background="#E8F5D8" CornerRadius="6"
                                        Padding="6 3" Margin="0 0 10 0">
                                    <TextBlock Text="🥧" FontSize="14"/>
                                </Border>
                                <TextBlock Text="Заказы по статусам"
                                           Style="{StaticResource SectionTitle}"
                                           Margin="0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <local:PieChart Items="{Binding OrdersByStatus}" Height="210"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ── СТРОКА 2: Столбчатый по сотрудникам + Таблица заказов ── -->
                <Grid Margin="0 4 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Столбчатый: выручка по сотрудникам -->
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                        Margin="0 0 0 8">
                                <Border Background="#E8F5D8" CornerRadius="6"
                                        Padding="6 3" Margin="0 0 10 0">
                                    <TextBlock Text="👤" FontSize="14"/>
                                </Border>
                                <TextBlock Text="Выручка по сотрудникам"
                                           Style="{StaticResource SectionTitle}"
                                           Margin="0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <local:BarChart Items="{Binding RevenueByWorker}" Height="200"/>
                        </DockPanel>
                    </Border>

                    <!-- Таблица отфильтрованных заказов -->
                    <Border Style="{StaticResource Card}" Grid.Column="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                        Margin="0 0 0 10">
                                <Border Background="#E8F5D8" CornerRadius="6"
                                        Padding="6 3" Margin="0 0 10 0">
                                    <TextBlock Text="📋" FontSize="14"/>
                                </Border>
                                <TextBlock Text="Детализация заказов"
                                           Style="{StaticResource SectionTitle}"
                                           Margin="0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding FilteredOrders}" MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#"
                                        Binding="{Binding OrderId}" Width="40"/>
                                    <DataGridTextColumn Header="Дата"
                                        Binding="{Binding Date, StringFormat=dd.MM.yy}" Width="70"/>
                                    <DataGridTextColumn Header="Стол"
                                        Binding="{Binding TableNumber}" Width="45"/>
                                    <DataGridTextColumn Header="Сотрудник"
                                        Binding="{Binding Worker}" Width="*"/>
                                    <DataGridTextColumn Header="Статус"
                                        Binding="{Binding Status}" Width="70"/>
                                    <DataGridTextColumn Header="Сумма"
                                        Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="85"/>
                                    <DataGridTextColumn Header="Оплата"
                                        Binding="{Binding PaymentMethod}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
