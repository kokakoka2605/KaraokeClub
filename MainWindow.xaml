<Window x:Class="KaraokeClub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:KaraokeClub.Converters"
        Title="PARC ZONE" Height="750" Width="1300"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#2d2d2d"
        Icon="/logo.png">

    <Window.Resources>
        <conv:RowNumberConverter x:Key="RowNum"/>
        <conv:EqToVisibilityConverter x:Key="EqToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns"      Value="False"/>
            <Setter Property="CanUserAddRows"           Value="False"/>
            <Setter Property="CanUserDeleteRows"        Value="False"/>
            <Setter Property="IsReadOnly"               Value="True"/>
            <Setter Property="Background"               Value="#2d2d2d"/>
            <Setter Property="RowBackground"            Value="#2d2d2d"/>
            <Setter Property="AlternatingRowBackground" Value="#333333"/>
            <Setter Property="Foreground"               Value="#e8e8e8"/>
            <Setter Property="BorderBrush"              Value="#444444"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3a3a3a"/>
            <Setter Property="SelectionMode"            Value="Single"/>
            <Setter Property="SelectionUnit"            Value="FullRow"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#4a7c1f"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="10 8"/>
            <Setter Property="BorderThickness" Value="0 0 1 0"/>
            <Setter Property="BorderBrush"     Value="#3d6618"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3d4a2d"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding"         Value="8 5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground"  Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background"      Value="#4a7c1f"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14 7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5a9625"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3a3a3a"/>
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#4a6fa5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5a82bc"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#8b2c2c"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#b03333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#383838"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#c8e000"/>
            <Setter Property="BorderThickness" Value="0 0 0 1"/>
            <Setter Property="Padding"         Value="8 6"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Width"           Value="220"/>
            <Setter Property="CaretBrush"      Value="White"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#383838"/>
            <Setter Property="Foreground" Value="#aaa"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Padding"    Value="14 8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" Margin="0 0 2 0">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4a7c1f"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected"  Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#404040"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Grid>
        <DockPanel>

            <Border DockPanel.Dock="Top" Background="#242424" Padding="20 12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Лого + название -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/logo.png" Width="70" Height="45" RenderTransformOrigin="0.685,0.5"/>
                        <StackPanel Width="136" VerticalAlignment="Center">
                            <TextBlock Text="PARK ZONE" FontSize="18" FontWeight="Bold" Foreground="#c8e000" Width="134"/>
                            <TextBlock Text="CRM система управления" FontSize="11" Foreground="#888" Width="133"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Кнопки и бейдж роли -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">

                        <!-- Бейдж роли -->
                        <Border CornerRadius="5" Padding="10 6" Margin="0 0 14 0" VerticalAlignment="Center"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1e2a10"/>
                                    <Setter Property="BorderBrush" Value="#4a7c1f"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdmin}" Value="False">
                                            <Setter Property="Background" Value="#2a2a2a"/>
                                            <Setter Property="BorderBrush" Value="#555"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👑 Администратор" Foreground="#c8e000" FontWeight="Bold" FontSize="12"
                                           Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="👤 Пользователь" Foreground="#999" FontSize="12"
                                           VerticalAlignment="Center">
                                    <TextBlock.Visibility>
                                        <Binding Path="IsAdmin" Converter="{StaticResource EqToVisibility}" ConverterParameter="False"/>
                                    </TextBlock.Visibility>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Разделитель -->
                        <Rectangle Width="1" Height="26" Fill="#3a3a3a" Margin="0 0 14 0" VerticalAlignment="Center"/>

                        <!-- Dashboard -->
                        <Button Click="OpenDashboard_Click" Margin="0 0 6 0" Padding="13 7" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#2e2e2e" BorderBrush="#4a7c1f" BorderThickness="1"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3a3a3a"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#c8e000"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="13" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="White"/>
                                <TextBlock Text="Dashboard" Foreground="#c8e000" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Отчёты -->
                        <Button Click="OpenReports_Click" Margin="0 0 14 0" Padding="13 7" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#2e2e2e" BorderBrush="#4a7c1f" BorderThickness="1"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3a3a3a"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#c8e000"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="13" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="White"/>
                                <TextBlock Text="Отчёты" Foreground="#c8e000" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Разделитель -->
                        <Rectangle Width="1" Height="26" Fill="#3a3a3a" Margin="0 0 14 0" VerticalAlignment="Center"/>

                        <!-- Бэкап -->
                        <Button Click="Backup_Click" Margin="0 0 6 0" Padding="13 7" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#2e2e2e" BorderBrush="#555" BorderThickness="1"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3a3a3a"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#888"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="13" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="White"/>
                                <TextBlock Text="Бэкап" Foreground="#ccc" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Восстановить -->
                        <Button Click="Restore_Click" Margin="0 0 14 0" Padding="13 7" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#2e2e2e" BorderBrush="#555" BorderThickness="1"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3a3a3a"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#888"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="13" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="White"/>
                                <TextBlock Text="Восстановить" Foreground="#ccc" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Выйти -->
                        <Button Click="Logout_Click" Padding="13 7" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#2e2e2e" BorderBrush="#6b2828" BorderThickness="1"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3d1e1e"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#a03030"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚪" FontSize="13" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="White"/>
                                <TextBlock Text="Выйти" Foreground="#cc6666" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Background="#242424" BorderThickness="0" Padding="0" SelectionChanged="TabControl_SelectionChanged">

                <!-- РОЛИ -->
                <TabItem Header="🏷 Роли">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0 0 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource SearchBox}" HorizontalAlignment="Left"
                                 Text="{Binding RolesVM.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="＋ Добавить" Style="{StaticResource BtnPrimary}" Command="{Binding RolesVM.AddCommand}"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}"/>
                                <Button Content="✎ Изменить" Style="{StaticResource BtnSecondary}" Margin="6 0 0 0"
                                    Command="{Binding RolesVM.EditCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=RolesGrid}"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}"/>
                                <Button Content="✕ Удалить" Style="{StaticResource BtnDanger}" Margin="6 0 0 0"
                                    Command="{Binding RolesVM.DeleteCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=RolesGrid}"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" x:Name="RolesGrid" ItemsSource="{Binding RolesVM.View}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="№" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" Foreground="White">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource RowNum}">
                                                        <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                                        <Binding/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Название" Binding="{Binding Name}"   Width="*"/>
                                <DataGridTextColumn Header="Зарплата" Binding="{Binding Salary, StringFormat={}{0:F2}}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ТИПЫ МЕНЮ -->
                <TabItem Header="📋 Типы меню">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0 0 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource SearchBox}" HorizontalAlignment="Left"
                                 Text="{Binding MenuTypesVM.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}">
                                <Button Content="＋ Добавить" Style="{StaticResource BtnPrimary}" Command="{Binding MenuTypesVM.AddCommand}"/>
                                <Button Content="✎ Изменить" Style="{StaticResource BtnSecondary}" Margin="6 0 0 0" Command="{Binding MenuTypesVM.EditCommand}" CommandParameter="{Binding SelectedItem, ElementName=TypesGrid}"/>
                                <Button Content="✕ Удалить"  Style="{StaticResource BtnDanger}"   Margin="6 0 0 0" Command="{Binding MenuTypesVM.DeleteCommand}" CommandParameter="{Binding SelectedItem, ElementName=TypesGrid}"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" x:Name="TypesGrid" ItemsSource="{Binding MenuTypesVM.View}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="№" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" Foreground="White">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource RowNum}">
                                                        <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                                        <Binding/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Тип" Binding="{Binding Name}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ОПЦИИ KARAOKE -->
                <TabItem Header="🎵 Опции Karaoke">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0 0 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource SearchBox}" HorizontalAlignment="Left"
                                 Text="{Binding KaraokeVM.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}">
                                <Button Content="＋ Добавить" Style="{StaticResource BtnPrimary}" Command="{Binding KaraokeVM.AddCommand}"/>
                                <Button Content="✎ Изменить" Style="{StaticResource BtnSecondary}" Margin="6 0 0 0" Command="{Binding KaraokeVM.EditCommand}" CommandParameter="{Binding SelectedItem, ElementName=KaraokeGrid}"/>
                                <Button Content="✕ Удалить"  Style="{StaticResource BtnDanger}"   Margin="6 0 0 0" Command="{Binding KaraokeVM.DeleteCommand}" CommandParameter="{Binding SelectedItem, ElementName=KaraokeGrid}"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" x:Name="KaraokeGrid" ItemsSource="{Binding KaraokeVM.View}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="№" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" Foreground="White">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource RowNum}">
                                                        <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                                        <Binding/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Название" Binding="{Binding Name}"        Width="*"/>
                                <DataGridTextColumn Header="Цена"     Binding="{Binding Price, StringFormat={}{0:F2}}" Width="100"/>
                                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="250"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- СОТРУДНИКИ -->
                <TabItem Header="👨‍💼 Сотрудники">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0 0 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource SearchBox}" HorizontalAlignment="Left"
                                 Text="{Binding WorkersVM.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}">
                                <Button Content="＋ Добавить" Style="{StaticResource BtnPrimary}" Command="{Binding WorkersVM.AddCommand}"/>
                                <Button Content="✎ Изменить" Style="{StaticResource BtnSecondary}" Margin="6 0 0 0" Command="{Binding WorkersVM.EditCommand}" CommandParameter="{Binding SelectedItem, ElementName=WorkersGrid}"/>
                                <Button Content="✕ Удалить"  Style="{StaticResource BtnDanger}"   Margin="6 0 0 0" Command="{Binding WorkersVM.DeleteCommand}" CommandParameter="{Binding SelectedItem, ElementName=WorkersGrid}"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" x:Name="WorkersGrid" ItemsSource="{Binding WorkersVM.View}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="№" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" Foreground="White">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource RowNum}">
                                                        <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                                        <Binding/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ФИО"     Binding="{Binding Name}"      Width="*"/>
                                <DataGridTextColumn Header="Роль"    Binding="{Binding Role.Name}" Width="130"/>
                                <DataGridTextColumn Header="IDNP"    Binding="{Binding Idnp}"      Width="130"/>
                                <DataGridTextColumn Header="Дата рождения" Binding="{Binding Birth, StringFormat=dd.MM.yyyy}" Width="120"/>
                                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}"     Width="110"/>
                                <DataGridTextColumn Header="Адрес"   Binding="{Binding Address}"   Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- МЕНЮ -->
                <TabItem Header="🍽 Меню">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0 0 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource SearchBox}" HorizontalAlignment="Left"
                                 Text="{Binding MenuItemsVM.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}">
                                <Button Content="＋ Добавить" Style="{StaticResource BtnPrimary}" Command="{Binding MenuItemsVM.AddCommand}"/>
                                <Button Content="✎ Изменить" Style="{StaticResource BtnSecondary}" Margin="6 0 0 0" Command="{Binding MenuItemsVM.EditCommand}" CommandParameter="{Binding SelectedItem, ElementName=MenuGrid}"/>
                                <Button Content="✕ Удалить"  Style="{StaticResource BtnDanger}"   Margin="6 0 0 0" Command="{Binding MenuItemsVM.DeleteCommand}" CommandParameter="{Binding SelectedItem, ElementName=MenuGrid}"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" x:Name="MenuGrid" ItemsSource="{Binding MenuItemsVM.View}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="№" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" Foreground="White">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource RowNum}">
                                                        <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                                        <Binding/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Название"    Binding="{Binding Name}"              Width="*"/>
                                <DataGridTextColumn Header="Тип"         Binding="{Binding Type.Name}"          Width="120"/>
                                <DataGridTextColumn Header="Секция"      Binding="{Binding Section}"            Width="80"/>
                                <DataGridTextColumn Header="Цена"        Binding="{Binding Price, StringFormat={}{0:F2}}" Width="80"/>
                                <DataGridTextColumn Header="Вес/Объём"   Binding="{Binding WeightVolume}"       Width="90"/>
                                <DataGridTextColumn Header="Время (мин)" Binding="{Binding CookingTime}"        Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="📝 Заказы">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0 0 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource SearchBox}" HorizontalAlignment="Left"
                 Text="{Binding OrdersVM.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- Кнопка «Позиции» — видна всем (просмотр) -->
                                <Button Content="👁 Позиции"
                        Background="#2a5a8a"
                        Margin="0 0 6 0"
                        Click="ViewOrderItems_Click"
                        Tag="{Binding SelectedItem, ElementName=OrdersGrid}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                                            <Setter Property="Background" Value="#2a5a8a"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3a70b0"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#3a3a3a"/>
                                                    <Setter Property="Foreground" Value="#666"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Кнопки CRUD — только для админа -->
                                <Button Content="＋ Добавить" Style="{StaticResource BtnPrimary}"
                        Command="{Binding OrdersVM.AddCommand}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}"/>
                                <Button Content="✎ Изменить" Style="{StaticResource BtnSecondary}" Margin="6 0 0 0"
                        Command="{Binding OrdersVM.EditCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=OrdersGrid}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}"/>
                                <Button Content="✕ Удалить"  Style="{StaticResource BtnDanger}"   Margin="6 0 0 0"
                        Command="{Binding OrdersVM.DeleteCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=OrdersGrid}"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" x:Name="OrdersGrid"
                  ItemsSource="{Binding OrdersVM.View}"
                  SelectionChanged="OrdersGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="№" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" Foreground="White">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource RowNum}">
                                                        <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                                        <Binding/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="№ заказа" Binding="{Binding Id}" Width="80"/>
                                <DataGridTextColumn Header="Стол"      Binding="{Binding TableNumber}"       Width="70"/>
                                <DataGridTextColumn Header="Сотрудник" Binding="{Binding Worker.Name}"       Width="*"/>
                                <DataGridTextColumn Header="Статус"    Binding="{Binding Status}"            Width="100"/>
                                <DataGridTextColumn Header="Гостей"    Binding="{Binding GuestCount}"        Width="80"/>
                                <DataGridTextColumn Header="Создан"    Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ПОЗИЦИИ ЗАКАЗОВ -->
                <TabItem Header="🧾 Позиции заказов">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0 0 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource SearchBox}" HorizontalAlignment="Left"
                                 Text="{Binding OrderItemsVM.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}">
                                <Button Content="＋ Добавить" Style="{StaticResource BtnPrimary}" Command="{Binding OrderItemsVM.AddCommand}"/>
                                <Button Content="✎ Изменить" Style="{StaticResource BtnSecondary}" Margin="6 0 0 0" Command="{Binding OrderItemsVM.EditCommand}" CommandParameter="{Binding SelectedItem, ElementName=OItemsGrid}"/>
                                <Button Content="✕ Удалить"  Style="{StaticResource BtnDanger}"   Margin="6 0 0 0" Command="{Binding OrderItemsVM.DeleteCommand}" CommandParameter="{Binding SelectedItem, ElementName=OItemsGrid}"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" x:Name="OItemsGrid" ItemsSource="{Binding OrderItemsVM.View}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="№" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" Foreground="White">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource RowNum}">
                                                        <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                                        <Binding/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Заказ №" Binding="{Binding OrderId}"           Width="80"/>
                                <DataGridTextColumn Header="Тип"     Binding="{Binding ItemType}"          Width="80"/>
                                <DataGridTextColumn Header="Блюдо"   Binding="{Binding Product.Name}"      Width="*"/>
                                <DataGridTextColumn Header="Karaoke" Binding="{Binding Option.Name}"       Width="130"/>
                                <DataGridTextColumn Header="Кол-во"  Binding="{Binding Quantity}"          Width="70"/>
                                <DataGridTextColumn Header="Цена"    Binding="{Binding PriceAtOrder, StringFormat={}{0:F2}}" Width="90"/>
                                <DataGridTextColumn Header="Заметка" Binding="{Binding Notes}"             Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- СЧЕТА -->
                <TabItem Header="💳 Счета">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0 0 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource SearchBox}" HorizontalAlignment="Left"
                                 Text="{Binding BillsVM.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}">
                                <Button Content="✎ Изменить" Style="{StaticResource BtnSecondary}" Command="{Binding BillsVM.EditCommand}" CommandParameter="{Binding SelectedItem, ElementName=BillsGrid}"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" x:Name="BillsGrid" ItemsSource="{Binding BillsVM.View}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="№" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" Foreground="White">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource RowNum}">
                                                        <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                                        <Binding/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Заказ №" Binding="{Binding OrderId}"           Width="80"/>
                                <DataGridTextColumn Header="Итого"   Binding="{Binding TotalAmount, StringFormat={}{0:F2}}" Width="100"/>
                                <DataGridTextColumn Header="Депозит" Binding="{Binding Deposit, StringFormat={}{0:F2}}"     Width="90"/>
                                <DataGridTextColumn Header="Оплата"  Binding="{Binding PaymentMethod}"     Width="100"/>
                                <DataGridTextColumn Header="Статус"  Binding="{Binding BillStatus}"        Width="100"/>
                                <DataGridTextColumn Header="Дата"    Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>


                <TabItem Header="👤 Пользователи"
                     Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0 0 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource SearchBox}" HorizontalAlignment="Left"
                                 Text="{Binding AppUsersVM.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="＋ Добавить" Style="{StaticResource BtnPrimary}"
                                    Command="{Binding AppUsersVM.AddCommand}"/>
                                <Button Content="✎ Изменить" Style="{StaticResource BtnSecondary}" Margin="6 0 0 0"
                                    Command="{Binding AppUsersVM.EditCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=AppUsersGrid}"/>
                                <Button Content="✕ Удалить" Style="{StaticResource BtnDanger}" Margin="6 0 0 0"
                                    Command="{Binding AppUsersVM.DeleteCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=AppUsersGrid}"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" x:Name="AppUsersGrid" ItemsSource="{Binding AppUsersVM.View}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AppRole}" Value="admin">
                                            <Setter Property="Background" Value="#3a2a10"/>
                                            <Setter Property="ToolTip"   Value="Аккаунт администратора — нельзя редактировать или удалить"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="№" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" Foreground="White">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource RowNum}">
                                                        <Binding RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                                                        <Binding/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Логин" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🔒 " Visibility="{Binding AppRole, Converter={StaticResource EqToVisibility}, ConverterParameter=admin}" Foreground="#ffb347" FontSize="11"/>
                                                <TextBlock Text="{Binding Username}" Foreground="White"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Пароль"     Binding="{Binding Password}"  Width="160"/>
                                <DataGridTextColumn Header="Роль"       Binding="{Binding AppRole}"   Width="100"/>
                                <DataGridTextColumn Header="Сотрудник"  Binding="{Binding Worker}"    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Toast notifications overlay -->
        <StackPanel x:Name="ToastHost"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0,0,20,20"
                Width="360"
                IsHitTestVisible="False"/>
    </Grid>
</Window>